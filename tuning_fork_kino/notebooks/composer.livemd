pitched_strings =
  part(bpm: 100, synth: strings, gain: 0.25)
  |> repeat("nilnilnilnilni", fn bar ->
    steps(
      bar,
      [
        {:d3, release: 8 / 4},
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        {:as3, release: 8 / 4},
        nil,
