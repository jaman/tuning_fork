      pitched_epiano_3,
      pitched_pipe,
      pitched_pipe_2,
      pitched_epiano_4,
      pitched_strings
    ],
    bpm: 100,
    beats: 112
  )

song
|> Score.render(44100)
|> TuningFork.Fx.reverb(44100, room: 0.25, mix: 0.2)
|> TuningFork.Wav.encode(rate: 44100)
|> Kino.Audio.new(:wav)
```

## Live patterns, the Strudel way

The tune as strudel.cc would have it: `setcps`, a `stack` of patterns, `.mask` and `.bank`
as methods. A cycle is two beats — one chord — so `<a b c d>` walks the four chords and
`setcps(0.8333)` is 100 bpm. The arrangement is in the masks: each digit of
`"<0 1 1 1 0 1 1>/8"` switches its pattern on or off for eight cycles, so the seven digits
are the seven sections. Edit and press **Evaluate** (or ctrl+enter): the change lands at the
next cycle line. `.bank("RolandTR909")` plays the drum machine's recordings once they have
arrived, the kit's own drums until then. The same rows can be written as this library's own
`s("bd") |> bank("RolandTR909")` pipelines, one per line — see `strudel.livemd` for both.

<!-- livebook:{"attrs":"","chunks":null,"kind":"Elixir.KinoTuningFork.LivePatternsCell","livebook_object":"smart_cell"} -->

```elixir
unless Process.whereis(TuningFork.Stage), do: Kino.render(KinoTuningFork.stage())

rows = [
  %{source: "// one tune, arranged: each digit of a mask is eight cycles, one section"},
  %{source: "setcps(0.8333)"},
  %{source: "let sections = \"<0 1 1 1 0 1 1>/8\""},
  %{source: "stack("},
  %{source: "  stack( // DRUMS"},
  %{
    source:
      "    s(\"<[bd ~] [[bd ~ bd ~] ~] [bd ~] [[bd ~ bd ~] [~ bd ~ ~]]>, ~ sd, <~ [~ cp] ~ [~ cp]>\")"
  },
  %{source: "      .mask(sections).gain(.35),"},
  %{source: "    s(\"<hh*4 [hh hh hh oh]>\").mask(\"<[0 1] 1 1 1 1 1 1>/8\").gain(.25)"},
  %{source: "  ).bank(\"RolandTR909\"),"},
  %{source: "  // BASS"},
  %{
    source:
      "  n(\"<[0 0 4] [5 5 2] [2 2 6] [6 6 3]>\").scale(\"d2:minor\").struct(\"x@2 ~ x x@2 x ~\")"
  },
  %{source: "    .s(\"gm_electric_bass_finger\").mask(\"<0 1 1 1 1 1 1>/8\").gain(.5),"},
  %{source: "  // CHORDS"},
  %{source: "  note(\"<[d3,f3,a3] [d3,f3,bb3] [c3,f3,a3] [c3,e3,g3]>\").struct(\"x@4 ~@2 x@2\")"},
  %{source: "    .s(\"gm_epiano1\").phaser(2).room(.4).gain(.3),"},
  %{source: "  // MELODY"},
  %{
    source: "  note(\"<[a4@3 f4 d4@2 f4@2] [g4@3 f4 d4@4] [f4@2 a4@2 c5@3 a4] [g4@4 e4@2 ~@2]>\")"
  },
  %{source: "    .s(\"gm_flute\").mask(\"<0 0 1 1 0 1 1>/8\").room(.3).gain(.4),"},
  %{source: "  note(\"<[d5@2 ~ a4 ~@3 f4@2] [~@3 e4 f4@2 d4@2]>\").s(\"gm_flute\")"},
  %{source: "    .delay(.3).room(.6).mask(\"<0 0 0 0 1 0 0>/8\").gain(.4),"},
  %{
    source:
      "  note(\"<[d4 f4 a4 d5] [d4 f4 bb4 d5] [c4 f4 a4 c5] [c4 e4 g4 c5]>*2\").s(\"gm_epiano1\")"
  },
  %{source: "    .mask(\"<0 0 0 0 0 1 1>/8\").pan(\"<.3 -.3>\").gain(.2),"},
  %{source: "  // PAD"},
  %{source: "  note(\"<d3 bb3 f3 c4>\").s(\"gm_string_ensemble_1\").room(.5).gain(.3)"},
  %{source: ")"}
]

pattern = TuningFork.Session.combined(rows)

if TuningFork.Stage.cycle() do
  TuningFork.Stage.update_pattern(pattern, at: :cycle)
else
  TuningFork.Stage.start_pattern(pattern, cps: 0.8333)
end
```

## Live loops, the Sonic Pi way

Named loops, each on its own length, in Sonic Pi's words — `sample`, `play`, `sleep`,
`play_pattern_timed`, `with_fx` — and ordinary Elixir around them. Every loop but the pad is
two bars long and reads its section from `tick()`, its own round counter, against the same
`"ABCCDEE"` the masks spell above. Evaluate a loop and it swaps in when it next comes round.
`use_synth "gm_epiano1"` plays a General MIDI instrument through the kit; `use_synth :tb303`
and the other synths are there too.

<!-- livebook:{"attrs":"","chunks":null,"kind":"Elixir.KinoTuningFork.LiveLoopsCell","livebook_object":"smart_cell"} -->

```elixir
unless Process.whereis(TuningFork.Stage), do: Kino.render(KinoTuningFork.stage())

use TuningFork.SonicPi

live_loop :drums do
  use_bpm 100
  section = String.at("ABCCDEE", div(rem(tick(), 14), 2))
  use_sample_defaults amp: if(section in ~w(B C E), do: 0.6, else: 0.0)

  for _bar <- 1..2 do
    sample :bd_haus
    sleep 1
    sample :sn_dolf
    sleep 1
    sample :bd_haus
    sleep 0.5
    sample :bd_haus
    sleep 0.5
    sample :sn_dolf
    sample :perc_snap
    sleep 1
  end
end

live_loop :hats do
  use_bpm 100
  section = String.at("ABCCDEE", div(rem(tick(), 14), 2))
  level = if section == "A", do: 0.2, else: 0.4

  for step <- 0..15 do
    sample if(step == 15, do: :drum_cymbal_open, else: :drum_cymbal_closed), amp: level
    sleep 0.5
  end
end

live_loop :bass do
  use_bpm 100
  use_synth "gm_electric_bass_finger"
  section = String.at("ABCCDEE", div(rem(tick(), 14), 2))

  if section == "A" do
    sleep 8
  else
    play_pattern_timed [
                         :d2,
                         :d2,
                         :d2,
                         :a2,
                         :bb2,
                         :bb2,
                         :bb2,
                         :f2,
                         :f2,
                         :f2,
                         :f2,
                         :c3,
                         :c3,
                         :c3,
                         :c3,
                         :g2
                       ],
                       [0.75, 0.25, 0.5, 0.5], release: 0.3
  end
end

live_loop :chords do
  use_bpm 100
  use_synth "gm_epiano1"
  use_synth_defaults amp: 0.6

  for notes <- [[:d3, :f3, :a3], [:d3, :f3, :bb3], [:c3, :f3, :a3], [:c3, :e3, :g3]] do
    play_chord notes, release: 1
    sleep 1.5
    play_chord notes, release: 0.5
    sleep 0.5
  end
end

live_loop :melody do
  use_bpm 100
  use_synth "gm_flute"
  tune = [:a4, :f4, :d4, :f4, :g4, :f4, :d4, :f4, :a4, :c5, :a4, :g4, :e4]
  times = [0.75, 0.25, 0.5, 0.5, 0.75, 0.25, 1, 0.5, 0.5, 0.75, 0.25, 1, 1]

  case String.at("ABCCDEE", div(rem(tick(), 14), 2)) do
    "C" ->
      play_pattern_timed tune, times, release: 0.4

    "E" ->
      play_pattern_timed tune, times, release: 0.4, amp: 1.2

    "D" ->
      with_fx :echo, phase: 0.375, mix: 0.3 do
        play_pattern_timed [:d5, :a4, :f4, :e4, :f4, :d4], [1, 0.5, 2.5, 0.5, 1, 2.5],
          release: 0.5
      end

    _ ->
      sleep 8
  end
end

live_loop :arpeggio do
  use_bpm 100
  use_synth "gm_epiano1"

  if String.at("ABCCDEE", div(rem(tick(), 14), 2)) == "E" do
    for arp <- [
          [:d4, :f4, :a4, :d5],
          [:d4, :f4, :bb4, :d5],
          [:c4, :f4, :a4, :c5],
          [:c4, :e4, :g4, :c5]
        ] do
      play_pattern_timed arp ++ arp, 0.25, amp: 0.4, release: 0.2
    end
  else
    sleep 8
  end
end

live_loop :pad do
  use_bpm 100
  use_synth "gm_string_ensemble_1"
  play tick([:d3, :bb3, :f3, :c4]), release: 2, amp: 0.8
  sleep 2
end
```

## A MIDI file, heard

Point the cell at a `.mid` file and it becomes a `TuningFork.Score` — tempo map, note
lengths, velocity and pitch bend kept, drums guessed by channel — rendered to audio. A
relative path is taken from the notebook's own directory. `bwv971.mid` sits next to this
notebook in the repository; opened from elsewhere, the cell below fetches it first. The
written source shows the `TuningFork.Midi.read!/1` and `Gm.score/2` calls it stands for.

```elixir
midi = Path.expand("bwv971.mid", __DIR__)

unless File.exists?(midi) do
  {:ok, bytes} =
    TuningFork.Sample.Fetch.get(
      "https://raw.githubusercontent.com/jaman/tuning_fork/main/tuning_fork_kino/notebooks/bwv971.mid"
    )

  File.write!(midi, bytes)
end
```

<!-- livebook:{"attrs":"eyJicG0iOiIiLCJkcnVtX2dhaW4iOiIxLjAiLCJkcnVtcyI6ImF1dG8iLCJnYWluIjoiMC4yIiwibG9vcHMiOiIxIiwicGF0aCI6ImJ3djk3MS5taWQiLCJwbGFpbiI6ZmFsc2UsInJldmVyYiI6IiIsInZhcmlhYmxlIjoic2NvcmUifQ","chunks":null,"kind":"Elixir.KinoTuningFork.MidiCell","livebook_object":"smart_cell"} -->

```elixir
score =
  Path.expand("bwv971.mid", __DIR__)
  |> TuningFork.Midi.read!()
  |> TuningFork.Gm.score(gain: 0.2, drum_gain: 1, drum_channels: :auto)

score
|> TuningFork.Score.render(44100)
|> TuningFork.Wav.encode(rate: 44100)
|> Kino.Audio.new(:wav)
```

## A MIDI keyboard, both ways

This cell needs `tuning_fork_midi` in the setup cell above; without it the cell has
nothing to show. Plug in a keyboard and pick it under **In**: each key sounds on the cell's own stage with
the instrument chosen under **Voice** — press **▶ listen** once — and lights up blue on the
strip, with the pedal, the wheel and any knobs read out underneath. Pick an **Out** — a
hardware synth, a DAW, or the virtual port the cell offers, which other software on this
machine sees by name — and **play out** sends the pattern to it with MIDI clock; what goes
out lights up orange, and clicking a key sends that one note. The log shows both streams as
they pass. With no device at all, choose the two virtual ports and point any soft synth at
"TuningFork Out". The pattern is one expression, as a TF Patterns row is: `stack([...])`
for several at once.

<!-- livebook:{"attrs":"eyJjbG9jayI6dHJ1ZSwiY3BzIjoiMC41IiwiaW5wdXQiOiIwIiwib3V0cHV0IjoiMCIsInBhdHRlcm4iOiJzdGFjayhbcyhcImJkKjQsIGhoKjhcIiksIG4oXCIwIDQgNyA0XCIpIHw+IHNjYWxlKFwiYzptaW5vclwiKV0pIiwidm9pY2UiOiJnbV9waWFubyJ9","chunks":null,"kind":"Elixir.KinoTuningFork.MidiMonitorCell","livebook_object":"smart_cell"} -->

```elixir
unless Process.whereis(TuningFork.Stage), do: Kino.render(KinoTuningFork.stage())
{:ok, midi} = TuningFork.Midi.Monitor.start_link(voice: "gm_piano")
:ok = TuningFork.Midi.Monitor.open_input(midi, 0)
:ok = TuningFork.Midi.Monitor.open_output(midi, 0)

{:ok, pattern} =
  TuningFork.Pattern.Source.parse(
    "stack([s(\"bd*4, hh*8\"), n(\"0 4 7 4\") |> scale(\"c:minor\")])"
  )

:ok = TuningFork.Midi.Monitor.play(midi, pattern, cps: 0.5, clock: true)
midi
```

## The same things from code

Everything a cell does is a call in `TuningFork`. Module names are written out below because
the cells above have already imported `TuningFork.Part` and `TuningFork.SonicPi`, whose
`gain`, `note` and `scale` would clash with `TuningFork.Pattern.Control`'s. A stage in the
notebook:

```elixir
KinoTuningFork.stage()
```

The tune's drums started on it as a pattern, the bass added at the next cycle line, and
stopped:

```elixir
alias TuningFork.Pattern.Control

drums =
  Control.s("<[bd ~] [[bd ~ bd ~] ~] [bd ~] [[bd ~ bd ~] [~ bd ~ ~]]>, ~ sd, <hh*4 [hh hh hh oh]>")
  |> Control.bank("RolandTR909")
  |> Control.gain(0.4)

TuningFork.Stage.start_pattern(drums, cps: 0.8333)
```

```elixir
bass =
  Control.n("<[0 0 4] [5 5 2] [2 2 6] [6 6 3]>")
  |> Control.scale("d2:minor")
  |> Control.struct("x@2 ~ x x@2 x ~")
  |> Control.s("gm_electric_bass_finger")
  |> Control.gain(0.5)

TuningFork.Stage.update_pattern(TuningFork.Pattern.stack([drums, bass]), at: :cycle)
```

```elixir
TuningFork.Stage.stop_pattern()
```

The flute line and the chords as a score, rendered to a WAV the notebook plays without any
stage:

```elixir
alias TuningFork.{Gm, Part, Score, Voice, Wav}

base = Voice.new(shape: :saw, gain: 0.4, cutoff: 0.45)

flute =
  Part.part(bpm: 100, synth: Gm.for_program(73, base))
  |> Part.pattern([:a4, :f4, :d4, :f4], [0.75, 0.25, 0.5, 0.5])
  |> Part.pattern([:g4, :f4, :d4], [0.75, 0.25, 1.0])
  |> Part.pattern([:f4, :a4, :c5, :a4], [0.5, 0.5, 0.75, 0.25])
  |> Part.pattern([:g4, :e4], [1.0, 1.0])

chords =
  [[:d3, :f3, :a3], [:d3, :f3, :bb3], [:c3, :f3, :a3], [:c3, :e3, :g3]]
  |> Enum.reduce(Part.part(bpm: 100, synth: Gm.for_program(4, base)), fn notes, part ->
    part |> Part.chord(notes, 1.5) |> Part.chord(notes, 0.5)
  end)

Score.from_parts([flute, chords], bpm: 100, beats: 8)
|> Score.render(44_100)
|> Wav.encode(rate: 44_100)
|> Kino.Audio.new(:wav)
```
